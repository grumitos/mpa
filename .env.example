# Copia este archivo como .env y completa tus valores.
# Configuración del backend (Django). El .env solo se usa en local: en un despliegue se definen
# como variables de entorno. La configuración de Supabase va en frontend/src/environments/.

# Clave secreta de Django (opcional con DEBUG=True; sin ella se genera una efímera en cada arranque).
# Obligatoria con DEBUG=False. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Modo de depuración de Django: True en desarrollo local, False en un despliegue.
DEBUG=True

# Hosts permitidos, separados por comas (opcional; por defecto localhost y 127.0.0.1).
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes permitidos por CORS, separados por comas (opcional; solo si el frontend se sirve desde
# otro origen, como ng serve en el puerto 4200).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Correo del administrador que se crea al preparar la base de datos (con él se inicia sesión).
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Contraseña de ese administrador. Elige la tuya: mientras sea tu_clave_aqui no se crea el usuario.
DJANGO_SUPERUSER_PASSWORD=tu_clave_aqui

# Nombre de usuario del administrador (opcional; sin él se usa el correo).
DJANGO_SUPERUSER_USERNAME=
